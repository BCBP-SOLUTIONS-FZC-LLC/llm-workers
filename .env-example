# Copy to .env (`make setup` does it). Names are the upper-cased fields of Settings in
# generation/src/llm_workers_generation/config.py, and nothing else. The settings class does not read
# the file itself: export it before you start a worker (set -a; . ./.env; set +a).
#
# NOT here: GENERATION_DATABASE_URL, CORPUS_DATABASE_URL, PG_BOUNCER_MODE, S3_*, VALKEY_URL, QDRANT_URL,
# GATEWAY_BASE_URL, IAM_BASE_URL. `rag.engine.build_engine` reads them with its own settings
# (llm-retrieval-generation's .env-example, whose `make docker-up` starts the database and caches).
# Workflow-affecting numbers (reconcile interval, deadlines, fan-out bounds) are code, not environment:
# generation/src/llm_workers_generation/tuning.py (ADR-0004).

APP_ENV=local                       # local | dev | test | staging | prod (the platform metrics vocabulary). local, dev and test relax the namespace and codec-key checks
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Which queue this process polls (the queue, its -control queue and the Worker Deployment are derived).
WORKER_KIND=generation              # generation | extraction
WORKER_TIER=standard                # standard | enterprise | strict
BUILD_ID=dev                        # the Worker Deployment build id; the image tag in a deployed pod

# Temporal (docker-compose.yml starts a dev server on :7233, UI on :8233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default          # required outside local, dev and test
# Client certificate and key, mounted files; set both or neither. The system trust store is used.
# TEMPORAL_TLS_CERT_PATH=/var/run/temporal-tls/tls.crt
# TEMPORAL_TLS_KEY_PATH=/var/run/temporal-tls/tls.key

# Payload codec (AES-256-GCM): both required outside local, dev and test. The key file holds 32 raw bytes.
# PAYLOAD_CODEC_KEY_ID=k1
# PAYLOAD_CODEC_KEY_PATH=/var/run/codec/k1

# Capacity (per pod). The fleet cap MAX_REPLICAS x MAX_CONCURRENT_ACTIVITIES should equal FANOUT_MAX_GLOBAL.
MAX_CONCURRENT_ACTIVITIES=8
MAX_CONCURRENT_CONTROL_ACTIVITIES=16
MAX_CONCURRENT_WORKFLOW_TASKS=32
MAX_REPLICAS=12
FANOUT_MAX_GLOBAL=100
WORKER_SHUTDOWN_GRACE_SECONDS=600   # at least the section activity's start-to-close (600)

# Load shedding on a standard queue (a setting only: no controller reads it yet)
GATEWAY_SHED_THRESHOLD_PERCENT=25
GATEWAY_SHED_WINDOW_SECONDS=300

# Observability and probes
ENABLE_METRICS=true
OBSERVABILITY_DOMAIN=llm
METRICS_BIND_ADDRESS=0.0.0.0:9464   # the Temporal runtime: SDK telemetry and the workflow-side llm_workers_* metrics
HEALTH_PORT=8080                    # the ops server: /health /live /ready and /metrics (fastapicommon)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # tracing interceptor is on only when this is set
