#!/usr/bin/env bash
# Local commit gates: lockfile, formatting, lint, types and the architecture rules.
set -euo pipefail

if git diff --cached --name-only | grep -qE '^(pyproject\.toml|generation/pyproject\.toml|uv\.lock)$'; then
  echo "[pre-commit] checking uv.lock is in step with pyproject.toml..."
  make lock-check
fi

echo "[pre-commit] running fmt-check..."
make fmt-check

echo "[pre-commit] running lint..."
make lint

echo "[pre-commit] running typecheck..."
make typecheck

echo "[pre-commit] running the architecture rules (make arch)..."
make arch
